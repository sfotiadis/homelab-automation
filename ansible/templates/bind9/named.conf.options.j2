// BIND9 Options Configuration
// Generated by Ansible

options {
    directory "/var/cache/bind";

    // DNS forwarders for external queries
    forwarders {
{% for forwarder in dns_forwarders %}
        {{ forwarder }};
{% endfor %}
    };

    // Enable DNSSEC validation
    dnssec-validation auto;

    // Listen on all interfaces
    listen-on { any; };
    listen-on-v6 { any; };

    // Access Control Lists
    allow-query {
{% for network in allowed_networks %}
        {{ network }};
{% endfor %}
        localhost;
    };

    // Disable zone transfers by default
    allow-transfer { none; };

    // Enable recursion for authorized networks
    recursion yes;
    allow-recursion {
{% for network in allowed_networks %}
        {{ network }};
{% endfor %}
        localhost;
    };

    // Cache settings
    max-cache-size 256M;
};

// Include TSIG key for dynamic updates
include "/etc/bind/externaldns.key";
