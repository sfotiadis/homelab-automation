// BIND9 Local Zone Configuration - Primary Server
// Generated by Ansible

// Primary zone: {{ dns_domain_primary }}
zone "{{ dns_domain_primary }}" {
    type master;
    file "/var/lib/bind/db.{{ dns_domain_primary }}";
    allow-transfer { {{ dns_secondary_ip }}; };
    allow-update { key "externaldns-key"; };
    notify yes;
};

// Primary zone: {{ dns_domain_secondary }}
zone "{{ dns_domain_secondary }}" {
    type master;
    file "/var/lib/bind/db.{{ dns_domain_secondary }}";
    allow-transfer { {{ dns_secondary_ip }}; };
    allow-update { key "externaldns-key"; };
    notify yes;
};

// Reverse zone
zone "{{ reverse_zone }}" {
    type master;
    file "/var/lib/bind/{{ reverse_zone_file }}";
    allow-transfer { {{ dns_secondary_ip }}; };
    allow-update { key "externaldns-key"; };
    notify yes;
};
