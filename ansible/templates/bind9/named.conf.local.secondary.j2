// BIND9 Local Zone Configuration - Secondary Server
// Generated by Ansible

// Secondary zone: {{ dns_domain_primary }}
zone "{{ dns_domain_primary }}" {
    type slave;
    file "/var/lib/bind/db.{{ dns_domain_primary }}";
    masters { {{ dns_primary_ip }}; };
};

// Secondary zone: {{ dns_domain_secondary }}
zone "{{ dns_domain_secondary }}" {
    type slave;
    file "/var/lib/bind/db.{{ dns_domain_secondary }}";
    masters { {{ dns_primary_ip }}; };
};

// Reverse zone
zone "{{ reverse_zone }}" {
    type slave;
    file "/var/lib/bind/{{ reverse_zone_file }}";
    masters { {{ dns_primary_ip }}; };
};
