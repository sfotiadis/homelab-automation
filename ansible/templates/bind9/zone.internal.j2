; Zone file for {{ dns_domain_secondary }}
; Generated by Ansible

$TTL    604800
@       IN      SOA     dns1.{{ dns_domain_secondary }}. admin.{{ dns_domain_secondary }}. (
                        2024112201      ; Serial (YYYYMMDDNN)
                        604800          ; Refresh (1 week)
                        86400           ; Retry (1 day)
                        2419200         ; Expire (4 weeks)
                        604800 )        ; Negative Cache TTL (1 week)

; Name servers
@       IN      NS      dns1.{{ dns_domain_secondary }}.
@       IN      NS      dns2.{{ dns_domain_secondary }}.

; DNS servers
dns1    IN      A       {{ dns_primary_ip }}
dns2    IN      A       {{ dns_secondary_ip }}

; Zone records
{% for record in zone_records.internal %}
{{ record.name }}    IN      A       {{ record.ip }}
{% endfor %}

; Additional records will be added dynamically by ExternalDNS
