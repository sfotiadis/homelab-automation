; Reverse zone file
; Generated by Ansible

$TTL    604800
@       IN      SOA     dns1.internal. admin.internal. (
                        2024112201      ; Serial (YYYYMMDDNN)
                        604800          ; Refresh
                        86400           ; Retry
                        2419200         ; Expire
                        604800 )        ; Negative Cache TTL

; Name servers
@       IN      NS      dns1.internal.
@       IN      NS      dns2.internal.

; PTR records
{% for record in reverse_zone_records %}
{{ record.ip }}       IN      PTR     {{ record.fqdn }}
{% endfor %}
